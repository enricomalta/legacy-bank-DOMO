IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-WITHDRAW.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-FAILURES         PIC 9 VALUE 0.

01 WS-TEST-BALANCE     PIC S9(9)V99.
01 WS-TEST-AMOUNT      PIC S9(9)V99.
01 WS-TEST-CODE        PIC 9.

PROCEDURE DIVISION.

MAIN-PROCESS.


DISPLAY "================================="
DISPLAY "      TEST WITHDRAW"
DISPLAY "================================="
DISPLAY " "

PERFORM TEST-POSITIVE-WITHDRAW
PERFORM TEST-ZERO-WITHDRAW
PERFORM TEST-NEGATIVE-WITHDRAW
PERFORM TEST-INSUFFICIENT-BALANCE
PERFORM TEST-INVALID-PRESERVES-BALANCE

DISPLAY " "
DISPLAY "---------------------------------"
DISPLAY "Tests executados: 5"
DISPLAY "Falhas: " WS-FAILURES
DISPLAY "---------------------------------"

IF WS-FAILURES = 0
    DISPLAY "ALL TESTS PASSED"
    MOVE 0 TO RETURN-CODE
ELSE
    DISPLAY "TESTS FAILED"
    MOVE 1 TO RETURN-CODE
END-IF

GOBACK.


TEST-POSITIVE-WITHDRAW.


MOVE 1500.00 TO WS-TEST-BALANCE
MOVE 100.00 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "WITHDRAW"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 1400.00
   AND WS-TEST-CODE = 0
    DISPLAY "[PASS] Withdraw positive amount"
ELSE
    DISPLAY "[FAIL] Withdraw positive amount"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-ZERO-WITHDRAW.


MOVE 1500.00 TO WS-TEST-BALANCE
MOVE 0 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "WITHDRAW"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 1500.00
   AND WS-TEST-CODE = 1
    DISPLAY "[PASS] Withdraw zero amount"
ELSE
    DISPLAY "[FAIL] Withdraw zero amount"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-NEGATIVE-WITHDRAW.


MOVE 1500.00 TO WS-TEST-BALANCE
MOVE -100.00 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "WITHDRAW"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 1500.00
   AND WS-TEST-CODE = 1
    DISPLAY "[PASS] Withdraw negative amount"
ELSE
    DISPLAY "[FAIL] Withdraw negative amount"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-INSUFFICIENT-BALANCE.


MOVE 100.00 TO WS-TEST-BALANCE
MOVE 150.00 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "WITHDRAW"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 100.00
   AND WS-TEST-CODE = 2
    DISPLAY "[PASS] Withdraw insufficient balance"
ELSE
    DISPLAY "[FAIL] Withdraw insufficient balance"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-INVALID-PRESERVES-BALANCE.


MOVE 2500.00 TO WS-TEST-BALANCE
MOVE 0 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "WITHDRAW"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 2500.00
   AND WS-TEST-CODE = 1
    DISPLAY "[PASS] Invalid withdraw preserves balance"
ELSE
    DISPLAY "[FAIL] Invalid withdraw preserves balance"
    ADD 1 TO WS-FAILURES
END-IF.

