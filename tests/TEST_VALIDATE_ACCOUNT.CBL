IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-VALIDATE-ACCOUNT.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-FAILURES         PIC 9 VALUE 0.

01 WS-TEST-ACCOUNT-ID  PIC 9(10).
01 WS-TEST-CODE        PIC 9.

PROCEDURE DIVISION.

MAIN-PROCESS.


DISPLAY "================================="
DISPLAY "   TEST VALIDATE ACCOUNT"
DISPLAY "================================="
DISPLAY " "

PERFORM TEST-VALID-ACCOUNT
PERFORM TEST-UNKNOWN-ACCOUNT
PERFORM TEST-ZERO-ACCOUNT

DISPLAY " "
DISPLAY "---------------------------------"
DISPLAY "Tests executados: 3"
DISPLAY "Falhas: " WS-FAILURES
DISPLAY "---------------------------------"

IF WS-FAILURES = 0
    DISPLAY "ALL TESTS PASSED"
    MOVE 0 TO RETURN-CODE
ELSE
    DISPLAY "TESTS FAILED"
    MOVE 1 TO RETURN-CODE
END-IF

GOBACK.


TEST-VALID-ACCOUNT.


MOVE 1000000001 TO WS-TEST-ACCOUNT-ID
MOVE 9 TO WS-TEST-CODE

CALL "VALIDATE_ACCOUNT"
    USING WS-TEST-ACCOUNT-ID
          WS-TEST-CODE

IF WS-TEST-CODE = 0
    DISPLAY "[PASS] Valid account"
ELSE
    DISPLAY "[FAIL] Valid account"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-UNKNOWN-ACCOUNT.


MOVE 9999999999 TO WS-TEST-ACCOUNT-ID
MOVE 9 TO WS-TEST-CODE

CALL "VALIDATE_ACCOUNT"
    USING WS-TEST-ACCOUNT-ID
          WS-TEST-CODE

IF WS-TEST-CODE = 3
    DISPLAY "[PASS] Unknown account"
ELSE
    DISPLAY "[FAIL] Unknown account"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-ZERO-ACCOUNT.


MOVE 0 TO WS-TEST-ACCOUNT-ID
MOVE 9 TO WS-TEST-CODE

CALL "VALIDATE_ACCOUNT"
    USING WS-TEST-ACCOUNT-ID
          WS-TEST-CODE

IF WS-TEST-CODE = 3
    DISPLAY "[PASS] Zero account"
ELSE
    DISPLAY "[FAIL] Zero account"
    ADD 1 TO WS-FAILURES
END-IF.

