IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-DEPOSIT.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 WS-BALANCE          PIC S9(9)V99.
01 WS-AMOUNT           PIC S9(9)V99.
01 WS-RETURN-CODE      PIC 9.
01 WS-FAILURES         PIC 9 VALUE 0.

01 WS-TEST-BALANCE     PIC S9(9)V99.
01 WS-TEST-AMOUNT      PIC S9(9)V99.
01 WS-TEST-CODE        PIC 9.

PROCEDURE DIVISION.

MAIN-PROCESS.


DISPLAY "================================="
DISPLAY "      TEST DEPOSIT"
DISPLAY "================================="
DISPLAY " "

PERFORM TEST-POSITIVE-DEPOSIT
PERFORM TEST-ZERO-DEPOSIT
PERFORM TEST-NEGATIVE-DEPOSIT
PERFORM TEST-INVALID-PRESERVES-BALANCE

DISPLAY " "
DISPLAY "---------------------------------"
DISPLAY "Tests executados: 4"
DISPLAY "Falhas: " WS-FAILURES
DISPLAY "---------------------------------"

IF WS-FAILURES = 0
    DISPLAY "ALL TESTS PASSED"
    MOVE 0 TO RETURN-CODE
ELSE
    DISPLAY "TESTS FAILED"
    MOVE 1 TO RETURN-CODE
END-IF

GOBACK.


TEST-POSITIVE-DEPOSIT.


MOVE 1500.00 TO WS-TEST-BALANCE
MOVE 100.00 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "DEPOSIT"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 1600.00
   AND WS-TEST-CODE = 0
    DISPLAY "[PASS] Deposit positive amount"
ELSE
    DISPLAY "[FAIL] Deposit positive amount"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-ZERO-DEPOSIT.


MOVE 1500.00 TO WS-TEST-BALANCE
MOVE 0 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "DEPOSIT"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 1500.00
   AND WS-TEST-CODE = 1
    DISPLAY "[PASS] Deposit zero amount"
ELSE
    DISPLAY "[FAIL] Deposit zero amount"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-NEGATIVE-DEPOSIT.


MOVE 1500.00 TO WS-TEST-BALANCE
MOVE -100.00 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "DEPOSIT"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 1500.00
   AND WS-TEST-CODE = 1
    DISPLAY "[PASS] Deposit negative amount"
ELSE
    DISPLAY "[FAIL] Deposit negative amount"
    ADD 1 TO WS-FAILURES
END-IF.


TEST-INVALID-PRESERVES-BALANCE.


MOVE 2500.00 TO WS-TEST-BALANCE
MOVE 0 TO WS-TEST-AMOUNT
MOVE 9 TO WS-TEST-CODE

CALL "DEPOSIT"
    USING WS-TEST-BALANCE
          WS-TEST-AMOUNT
          WS-TEST-CODE

IF WS-TEST-BALANCE = 2500.00
   AND WS-TEST-CODE = 1
    DISPLAY "[PASS] Invalid deposit preserves balance"
ELSE
    DISPLAY "[FAIL] Invalid deposit preserves balance"
    ADD 1 TO WS-FAILURES
END-IF.

